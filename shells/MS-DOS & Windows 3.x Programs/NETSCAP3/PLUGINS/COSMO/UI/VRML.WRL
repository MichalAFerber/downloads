#VRML V2.0 utf8

#
# Netscape Live3D 2.0 Sample User Interface
#

EXTERNPROTO LayoutHint [ field SFString placement
                   		 field SFFloat widthFraction
                   		 field SFFloat heightFraction
                   		 field SFInt32 maxPixelWidth
                   		 field SFInt32 maxPixelHeight ]
[ "urn:inet:netscape.com:vrml/LayoutHint.wrl" ]

EXTERNPROTO CosmoBrowser [  eventIn  SFBool   set_gravity
                            eventIn  SFBool   set_collision
                            eventIn  SFBool   set_point
                            eventIn  SFBool   set_anyMode
                            eventIn  SFString set_navType
                            eventIn  SFBool   set_headlight
                            eventIn  SFFloat  set_headlightIntensity
                            eventIn  SFInt32  set_showHelp
                            eventIn  SFInt32  set_straighten
                            
                            eventOut SFBool   gravity_changed
                            eventOut SFBool   collision_changed
                            eventOut SFBool   point_changed
                            eventOut SFBool   anyMode_changed
                            eventOut SFString navType_changed
                            eventOut SFBool   headlight_changed
                            eventOut SFFloat  headlightIntensity_changed
                            eventOut MFInt32  rect_changed
                            eventOut SFInt32  numViewpoints_changed
                         ]
[ "urn:inet:netscape.com:vrml/CosmoBrowser.wrl" ]

DEF COSMOBROWSER CosmoBrowser { }

DirectionalLight
{
    direction -1 -1.5 -2
}

DEF LightSwitch Switch {
	whichChoice	-1
	choice [
		DEF MovingLight DirectionalLight 
		{
			direction  -1  0  0
		}
	]
}

DEF MovingLight-POS-INTERP PositionInterpolator {
	key [0, 1.0] 
	keyValue [-1  0  0,  0  1  0 ] }  

PROTO Button
[
    field    SFString string     "bogus"
    eventOut SFTime   touchTime
    eventIn  SFColor  color
]
{
    Anchor
    {
        url ""
        description IS string

        children
        [
            TouchSensor 
            {
                touchTime_changed IS touchTime
            }

            Shape
            {
                geometry Sphere { }
                appearance Appearance
                {
                    material Material
                    {
                        diffuseColor IS color
                        specularColor IS color
                        shininess .8
                    }
                }
            }
        ]
    }
}

PROTO ButtonScript
[
    eventIn  SFBool  handleChange
    eventOut SFColor Color
    eventIn  SFTime  handleHit
    eventOut SFBool  bs_setChanged
]
{
    Script
    {
        eventIn  SFBool  handleChange    IS handleChange
        eventOut SFColor Color           IS Color
        eventIn  SFTime  handleHit       IS handleHit
        eventOut SFBool  bs_setChanged   IS bs_setChanged

        field    SFBool  bStor FALSE

        url "javascript:
            function handleChange(bVal)
            {
                if (bVal)
                {
                    Color[0] = 0;
                    Color[1] = 1;
                    Color[2] = 0;
                }
                else
                {
                    Color[0] = 1;
                    Color[1] = 0;
                    Color[2] = 0;
                }
                bStor = bVal;
            }

            function handleHit(time)
            {
                if (bStor)
                    bs_setChanged = false;
                else
                    bs_setChanged = true;
            }"
    }
}

Transform
{
    children
    [
        LayoutHint 
        {
            placement BOTTOMLEFT
            widthFraction .035
        }

        Transform
        {
            children
            [
                Transform
                {
                    translation 0 4 0
                    scale 1 1 0.1 

                    children DEF SPIN_BUTTON Button { string "Right-mouse Spin" }
                }

                Transform
                {
                    translation 0 2 0
                    scale 1 1 0.1 

                    children DEF GRAVITY_BUTTON Button { string "Gravity" }
                }

                Transform
                {
                    translation 0 0 0
                    scale 1 1 0.1 

                    children DEF COLLISION_BUTTON Button { string "Collision" }
                }
            ]
        }
    ]
}

DEF SPIN_SCRIPT ButtonScript { }
DEF GRAVITY_SCRIPT ButtonScript { }
DEF COLLISION_SCRIPT ButtonScript { }

ROUTE SPIN_BUTTON.touchTime                 TO SPIN_SCRIPT.handleHit
ROUTE SPIN_SCRIPT.Color                     TO SPIN_BUTTON.color
ROUTE SPIN_SCRIPT.bs_setChanged             TO COSMOBROWSER.set_rightMouseSpin
ROUTE COSMOBROWSER.rightMouseSpin_changed   TO SPIN_SCRIPT.handleChange

ROUTE GRAVITY_BUTTON.touchTime              TO GRAVITY_SCRIPT.handleHit
ROUTE GRAVITY_SCRIPT.Color                  TO GRAVITY_BUTTON.color
ROUTE GRAVITY_SCRIPT.bs_setChanged          TO COSMOBROWSER.set_gravity
ROUTE COSMOBROWSER.gravity_changed          TO GRAVITY_SCRIPT.handleChange

ROUTE COLLISION_BUTTON.touchTime            TO COLLISION_SCRIPT.handleHit
ROUTE COLLISION_SCRIPT.Color                TO COLLISION_BUTTON.color
ROUTE COLLISION_SCRIPT.bs_setChanged        TO COSMOBROWSER.set_collision
ROUTE COSMOBROWSER.collision_changed        TO COLLISION_SCRIPT.handleChange

Transform
{
    children
    [
        LayoutHint 
        {
            placement BOTTOMCENTER
            widthFraction .40
            heightFraction .10
        }

        Transform
        {
            translation 0 0 -10

            children
            [
                Transform
                {
                    scale 1.5 .32 1

                    children
                    [
                        Shape
                        {
                            geometry IndexedFaceSet
                            {
                                coord Coordinate
                                {
                                    point
                                    [
                                        -2 2 0,
                                        2 2 0,
                                        2 -2 0,
                                        -2 -2 0,
                                        2 -2 2,
                                        -2 -2 2
                                    ]
                                }

                                coordIndex
                                [
                                    3, 2, 1, 0, -1,
                                    5, 4, 2, 3, -1
                                ]
                            }

                            appearance Appearance
                            {
                                material Material
                                {
                                    ambientIntensity 0
                                    diffuseColor .5 .5 .5
                                    specularColor .2 .2 .2
                                    shininess .9
                                    transparency .75
                                }
                            }
                        }
                    ]
                }

                DEF WALK_SHAPE Transform
                {
                    translation -1.5 0 1
                    scale .4 .4 .4
                    rotation 1 1 0 .5

                    children
                    [
                        Anchor
                        {
                            url "" 
                            description "Walk/Fly"

                            children
                            [
                                DEF WALK_TOUCHSENSOR TouchSensor {}

                                Shape
                                {
                                    geometry Box {}

                                    appearance Appearance
                                    {
                                        material DEF WALK_MATERIAL Material
                                        {
                                            ambientIntensity .28
                                            diffuseColor 1. 0. 0.
                                            transparency 0.0
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }

                DEF EXAMINE_SHAPE Transform
                {
                    scale .45 .45 .45
                    translation 0 0.45 1

                    children
                    [
                        Transform
                        {
                            translation 0 -1 0

                            children
                            [
                                Anchor
                                {
                                    url "" 
                                    description "Examine"

