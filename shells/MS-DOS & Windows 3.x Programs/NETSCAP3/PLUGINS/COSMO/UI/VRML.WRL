                                        {
                                            geometry Cone
                                            {
                                            }

                                            appearance Appearance
                                            {
                                                material DEF POINT_MATERIAL Material
                                                {
                                                    ambientIntensity .28
                                                    diffuseColor .5 .5 1.
                                                    transparency .5
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
