                                                material DEF EXAMINE_MATERIAL Material
                                                {
                                                    ambientIntensity .28
                                                    diffuseColor .2 1. .2
                                                    transparency .5
                                                    specularColor .1 .1 .1
                                                    shininess .6
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }

                DEF POINT_SHAPE Transform
                {
                    children
                    [
                        Transform
                        {
                            translation 1.5 0 1
                            scale .45 .4 .45
                            rotation 1 1 1 .5

