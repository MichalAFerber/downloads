Transform
{
    children
    [
        LayoutHint
		{
            placement BOTTOMRIGHT
            widthFraction .15
            heightFraction .15
        }

        Anchor
        {
            url "http://vrml.sgi.com/" 
            description "SGI Cosmo Player"

            children
            [
                Shape
                {
                    geometry IndexedFaceSet
                    {
                        coord Coordinate
                        {
                            point
                            [
                                -2.727272 1 0,
                                2.727272 1 0,
                                2.727272 -1 0,
                                -2.727272 -1 0
                            ]
                        }

                        texCoord TextureCoordinate
                        {
                            point
                            [
                                0 1,
                                1 1,
                                1 0,
                                0 0
                            ]
                        }

                        coordIndex
                        [
                            3, 2, 1, 0, -1
                        ]

                        texCoordIndex
                        [
                            3, 2, 1, 0, -1
                        ]
                    }

                    appearance Appearance
                    {
                        material Material
                        {
                            ambientIntensity .28
                            diffuseColor .5 .5 1
                            transparency .25
                        }

                        texture ImageTexture
                        {
                            url "netscape\cosmo.gif"
                        }
                    }
                }
            ]
        }
    ]
}

DEF WALK_SCRIPT Script
{
    eventIn  SFTime    touchTime
    eventOut SFString  setType

    url "javascript:
        function touchTime(nav)
        {
            setType = 'WALK';
        }"
}

DEF EXAMINE_SCRIPT Script
{
    eventIn SFTime    touchTime
    eventOut SFString  setType

    url "javascript:
        function touchTime(nav)
        {
            setType = 'SPIN';
        }"
}

DEF POINT_SCRIPT Script
{
    eventIn  SFTime   touchTime
    eventIn  SFBool   setPoint
    eventOut SFFloat  density
    eventOut SFTime   animateTime
    eventOut SFBool   bPoint_set

    field    SFBool   bPointMode         false

    url "javascript:
        function touchTime(nav)
        {
            bPoint_set = !bPointMode;
        }

        function setPoint(bPoint, time)
        {
            bPointMode = bPoint;

            if (bPoint)
                density = 0.0;
            else
                density = 0.5;
            animateTime = time;
        }"
}

DEF LAMP_SCRIPT Script
{
    eventIn  SFTime   touchTime
    eventIn  SFBool   setLamp
	eventOut SFTime   out1Time
	eventOut SFTime   out2Time
	eventOut SFBool   lightSwitch
	eventOut SFBool   lightSet
	eventOut SFColor  bulbLight

    field    SFBool   bLamp         FALSE

    url "javascript:
        function touchTime(nav, ts)
        {
            lightSet = !bLamp;
        }

        function setLamp(bOn, ts)
        {
            if (bLamp != bOn)
            {
                bLamp = bOn;
			    lightSwitch = bLamp - 1;

                if (bLamp)
                {
				    bulbLight[0] = 1 ;
				    bulbLight[1] = 1 ;
				    bulbLight[2] = 1 ;
                    out1Time = ts;
                }
                else
                {
				    bulbLight[0] = .3 ;
				    bulbLight[1] = .3 ;
				    bulbLight[2] = .3 ;
                    out2Time = ts;
                }
            }
        }"
}

DEF TYPE_SCRIPT Script
{
    eventIn  SFString setType

    eventOut SFFloat  walkDensity
    eventOut SFTime   walkActivate
    eventOut SFFloat  examineDensity
    eventOut SFTime   examineActivate

    url "javascript:
        function setType(str, ts)
        {
            if (str == 'SPIN' || str == 'EXAMINE')
            {
                walkDensity = 0.5;
                examineDensity  = 0.0;
                examineActivate = ts;
            }
            else if (str == 'WALK' || str == 'FLY')
            {
                walkDensity = 0.0;
                examineDensity  = 0.5;
                walkActivate = ts;
            }
            else
            {
                walkDensity = 0.65;
                examineDensity  = 0.65;
            }
        }"
}

DEF WALK_TIMER TimeSensor 
{ 
    enabled TRUE 
    cycleInterval 2 
    startTime 1 
    stopTime 0 
    loop FALSE 
}

DEF EXAMINE_TIMER TimeSensor 
{ 
    enabled TRUE 
    cycleInterval 1.5 
    startTime 1 
    stopTime 0 
    loop FALSE 
}

DEF POINT_TIMER TimeSensor 
{ 
    enabled TRUE 
    cycleInterval 2 
    startTime 1 
    stopTime 0 
    loop FALSE 
}

DEF WALK_ROTATE OrientationInterpolator 
{
    key           [ 0, 0.333, 0.667, 1 ]
    keyValue      [ 0 1 0 0, 0 1 0 2.0944, 0 1 0 4.1888, 0 1 0 6.28 ]
}

DEF WALK_HOP PositionInterpolator
{
    key           [ 0,        0.4,          0.45,      .6,         0.85,     0.9           1        ]
    keyValue      [ -1.5 0 1, -1.5 -0.1 1, -1.5 0  1, -1.5 1.6 1, -1.5 0 1, -1.5 -0.2 1,  -1.5 0 1 ]
}

DEF WALK_STRETCH PositionInterpolator
{
    key           [ 0,           0.4,         0.45,        0.5,          0.6,         0.85,        .9           1           ]
    keyValue      [ 0.4 0.4 0.4, 0.4 0.3 0.4, 0.4 0.4 0.4, 0.4 0.55 0.4, 0.4 0.4 0.4, 0.4 0.4 0.4, 0.4 0.2 0.4, 0.4 0.4 0.4 ]
}

DEF EXAMINE_ROTATE OrientationInterpolator 
{
    key           [ 0, 0.333, 0.667, 1 ]
    keyValue      [ 1 0 0 0, 1 0 0 -2.0944, 1 0 0 -4.1888, 1 0 0 -6.28 ]
}

DEF POINT_ROTATE OrientationInterpolator 
{
    key           [ 0, 0.333, 0.667, 1 ]
    keyValue      [ 0 1 0 0, 0 1 0 2.0944, 0 1 0 4.1888, 0 1 0 6.28 ]
}

ROUTE WALK_TOUCHSENSOR.touchTime     TO WALK_SCRIPT.touchTime
ROUTE EXAMINE_TOUCHSENSOR.touchTime  TO EXAMINE_SCRIPT.touchTime
ROUTE POINT_TOUCHSENSOR.touchTime    TO POINT_SCRIPT.touchTime
ROUTE TouchSensor01-SENSOR.touchTime TO LAMP_SCRIPT.touchTime

ROUTE POINT_SCRIPT.animateTime       TO POINT_TIMER.startTime
ROUTE POINT_SCRIPT.density           TO POINT_MATERIAL.transparency

ROUTE WALK_TIMER.fraction_changed    TO WALK_ROTATE.set_fraction
ROUTE EXAMINE_TIMER.fraction_changed TO EXAMINE_ROTATE.set_fraction
ROUTE POINT_TIMER.fraction_changed   TO POINT_ROTATE.set_fraction
ROUTE POINT_TIMER.fraction_changed   TO WALK_HOP.set_fraction
ROUTE POINT_TIMER.fraction_changed   TO WALK_STRETCH.set_fraction

ROUTE WALK_ROTATE.value_changed      TO WALK_SHAPE.set_rotation
ROUTE WALK_HOP.value_changed         TO WALK_SHAPE.set_translation
ROUTE WALK_STRETCH.value_changed     TO WALK_SHAPE.set_scale
ROUTE EXAMINE_ROTATE.value_changed   TO EXAMINE_SHAPE.set_rotation
ROUTE POINT_ROTATE.value_changed     TO POINT_SHAPE.set_rotation

ROUTE TYPE_SCRIPT.walkDensity        TO WALK_MATERIAL.transparency
ROUTE TYPE_SCRIPT.walkActivate       TO WALK_TIMER.startTime
ROUTE TYPE_SCRIPT.examineDensity     TO EXAMINE_MATERIAL.transparency
ROUTE TYPE_SCRIPT.examineActivate    TO EXAMINE_TIMER.startTime

ROUTE LAMP_SCRIPT.out1Time			 TO Base-TIMER.startTime
ROUTE LAMP_SCRIPT.out2Time			 TO Base-TIMER2.startTime
ROUTE LAMP_SCRIPT.lightSwitch		 TO LightSwitch.whichChoice
ROUTE LAMP_SCRIPT.bulbLight			 TO BulbLight.emissiveColor

ROUTE Base-TIMER.fraction_changed TO Bars2-POS-INTERP.set_fraction
ROUTE Bars2-POS-INTERP.value_changed TO Bars2-ROOT.set_translation
ROUTE Base-TIMER.fraction_changed TO Bars2-ROT-INTERP.set_fraction
ROUTE Bars2-ROT-INTERP.value_changed TO Bars2-ROOT.set_rotation
ROUTE Base-TIMER.fraction_changed TO Bars-POS-INTERP.set_fraction
ROUTE Bars-POS-INTERP.value_changed TO Bars-ROOT.set_translation
ROUTE Base-TIMER.fraction_changed TO Bars-ROT-INTERP.set_fraction
ROUTE Bars-ROT-INTERP.value_changed TO Bars-ROOT.set_rotation
ROUTE Base-TIMER.fraction_changed TO Cup-POS-INTERP.set_fraction
ROUTE Cup-POS-INTERP.value_changed TO Cup-ROOT.set_translation
ROUTE Base-TIMER.fraction_changed TO Cup-ROT-INTERP.set_fraction
ROUTE Cup-ROT-INTERP.value_changed TO Cup-ROOT.set_rotation
ROUTE Base-TIMER.fraction_changed TO Joint1-POS-INTERP.set_fraction
ROUTE Joint1-POS-INTERP.value_changed TO Joint1-ROOT.set_translation
#ROUTE Base-TIMER.fraction_changed TO MovingLight-POS-INTERP.set_fraction
#ROUTE MovingLight-POS-INTERP.value_changed TO MovingLight.direction

ROUTE Base-TIMER2.fraction_changed TO Bars2-POS-INTERP2.set_fraction
ROUTE Bars2-POS-INTERP2.value_changed TO Bars2-ROOT.set_translation
ROUTE Base-TIMER2.fraction_changed TO Bars2-ROT-INTERP2.set_fraction
ROUTE Bars2-ROT-INTERP2.value_changed TO Bars2-ROOT.set_rotation
ROUTE Base-TIMER2.fraction_changed TO Bars-POS-INTERP2.set_fraction
ROUTE Bars-POS-INTERP2.value_changed TO Bars-ROOT.set_translation
ROUTE Base-TIMER2.fraction_changed TO Bars-ROT-INTERP2.set_fraction
ROUTE Bars-ROT-INTERP2.value_changed TO Bars-ROOT.set_rotation
ROUTE Base-TIMER2.fraction_changed TO Cup-POS-INTERP2.set_fraction
ROUTE Cup-POS-INTERP2.value_changed TO Cup-ROOT.set_translation
ROUTE Base-TIMER2.fraction_changed TO Cup-ROT-INTERP2.set_fraction
ROUTE Cup-ROT-INTERP2.value_changed TO Cup-ROOT.set_rotation
ROUTE Base-TIMER2.fraction_changed TO Joint1-POS-INTERP2.set_fraction
ROUTE Joint1-POS-INTERP2.value_changed TO Joint1-ROOT.set_translation

ROUTE COSMOBROWSER.headlight_changed TO LAMP_SCRIPT.setLamp
ROUTE COSMOBROWSER.navType_changed TO TYPE_SCRIPT.setType
ROUTE COSMOBROWSER.point_changed TO POINT_SCRIPT.setPoint

ROUTE POINT_SCRIPT.bPoint_set TO COSMOBROWSER.set_point
ROUTE WALK_SCRIPT.setType TO COSMOBROWSER.set_navType
ROUTE EXAMINE_SCRIPT.setType TO COSMOBROWSER.set_navType
ROUTE LIGHT_SCRIPT.lightSet TO COSMOBROWSER.set_headlight
